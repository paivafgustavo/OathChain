# ============ Copie este arquivo para ".env" e preencha. O ".env" NUNCA vai para o GitHub. ============

# --- IA (todas têm plano gratuito; basta UMA, mas com mais de uma o serviço alterna se uma atingir o limite) ---
GROQ_API_KEY=            # console.groq.com  (sem cartão)
GEMINI_API_KEY=          # aistudio.google.com/apikey
OPENROUTER_API_KEY=      # openrouter.ai (modelos ":free")

# --- Evidências (opcionais, gratuitas) ---
FIRECRAWL_API_KEY=       # firecrawl.dev (plano grátis: 1.000 créditos/mês)
TAVILY_API_KEY=          # app.tavily.com (plano grátis: 1.000 buscas/mês, sem cartão). Cobre quando o Firecrawl acaba
FACTCHECK_API_KEY=       # Google Fact Check Tools API (chave grátis no Google Cloud)

# --- IPFS (opcional, gratuito) ---
# Com isto, cada relatório vai para o IPFS e a blockchain guarda "ipfs://CID": o site lê de qualquer gateway,
# mesmo com este computador desligado. Crie em app.pinata.cloud > API Keys > New Key (permissão pinFileToIPFS).
PINATA_JWT=

# --- Blockchain ---
RPC_URL=                 # a mesma URL da Sepolia usada no projeto principal
CONTRACT_ADDRESS=        # endereço do OathChain (deployments/sepolia.json)
# Carteira EXCLUSIVA do serviço de IA (crie uma nova no MetaMask, só com ETH de teste!).
# O endereço dela deve ser definido no contrato com AGENTE_VERIFICADOR no deploy (ou definirAgenteVerificador).
PRIVATE_KEY_AGENTE=

# --- Opções ---
LIMITE_DIARIO=50         # máximo de verificações por dia (protege suas cotas gratuitas)
INTERVALO_SEGUNDOS=30    # de quanto em quanto tempo procura afirmações novas
PORTA=8787
URL_PUBLICA=http://localhost:8787   # de onde o site lê os relatórios
# DEMO=1  # força o modo simulado (sem chaves de IA); é ligado sozinho se não houver nenhuma chave
